#.      @local.gap_cycle
#.      @local.gap_cycle_pour100
#.      (@fields.superficie_exploitation
msgctxt "global"
msgid "Après trois ans, @local.gap_cycle ha ou @local.gap_cycle_pour100 % de la superficie totale de l'UPA (@fields.superficie_exploitation ha) ne recevra pas de fumure organique."
msgstr ""

